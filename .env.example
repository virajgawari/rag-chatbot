# DocChat backend environment template.
# Copy to .env and fill in locally. Never commit real credentials.

ENVIRONMENT=development

# --- Groq (server-only) -------------------------------------------------------
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-120b
GROQ_TIMEOUT_SECONDS=30

# --- Embeddings ---------------------------------------------------------------
# Fixed 384-dimensional model. Changing it requires the re-embedding migration
# described in docs/backend-runbook.md; never mix vectors from two models.
EMBEDDING_MODEL_NAME=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_DIMENSION=384
EMBEDDING_BATCH_SIZE=32
EMBEDDING_TIMEOUT_SECONDS=120
DEFAULT_CHUNK_SIZE=1000
DEFAULT_CHUNK_OVERLAP=200

# --- Upload limits ------------------------------------------------------------
MAX_UPLOAD_SIZE_BYTES=20971520
ALLOWED_EXTENSIONS=.pdf,.docx,.txt

# --- Retrieval ----------------------------------------------------------------
SIMILARITY_THRESHOLD=0.2
DEFAULT_TOP_K=5

# --- Supabase Postgres (server-only) -----------------------------------------
# Use the Session pooler URI from the Supabase dashboard (port 5432). The
# direct db.<ref>.supabase.co host is IPv6-only on many networks.
DATABASE_URL=postgresql://postgres.project_ref:your_password@aws-0-region.pooler.supabase.com:5432/postgres?sslmode=require
DATABASE_POOL_MIN_SIZE=1
DATABASE_POOL_MAX_SIZE=10
DATABASE_STATEMENT_TIMEOUT_MS=15000
# Keep 0 for PgBouncer/Supabase poolers.
DATABASE_STATEMENT_CACHE_SIZE=0

# --- Supabase Storage (server-only) -----------------------------------------
# The bucket must be private. Run: python scripts/setup_storage.py
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here
SUPABASE_STORAGE_BUCKET=documents

# --- Local development storage (used when Supabase Storage is unset) ---------
LOCAL_STORAGE_DIR=storage/documents

# --- HTTP ---------------------------------------------------------------------
# Comma-separated exact origins. Optional regex for changing preview hostnames.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
CORS_ORIGIN_REGEX=
