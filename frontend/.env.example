# Local development: leave VITE_API_BASE_URL empty. Vite proxies /api to the
# FastAPI server below, so no CORS setup is needed in the browser.
VITE_API_BASE_URL=
VITE_API_PROXY_TARGET=http://127.0.0.1:8000

# Production (Vercel): set VITE_API_BASE_URL to the deployed backend, including
# the /api/v1 prefix. This is public configuration, never a secret.
# VITE_API_BASE_URL=https://your-backend.example.com/api/v1
